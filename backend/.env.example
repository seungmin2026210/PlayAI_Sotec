FIREBASE_PROJECT_ID=quote-dev
# 로컬 개발/테스트는 Firestore 에뮬레이터를 쓴다(인증 불필요):
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
# 실제 Firestore 에 붙일 때만 주석 해제하고 에뮬레이터 줄은 지운다. 서비스 계정
# 인증정보는 GOOGLE_APPLICATION_CREDENTIALS(파일 경로)로 별도 지정.
CORS_ORIGINS=http://localhost:5173
TOKEN_SECRET=dev-secret-change-me
TOKEN_TTL_HOURS=12
# 자산관리(ASSET-1) 계정 비밀번호 암호화 키(Fernet). 없으면 비밀번호 저장/열람만 501, 나머지는 정상.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 키를 잃으면 저장된 비밀번호는 복구할 수 없다 — 배포 키는 따로 백업해 둘 것. 저장소에 커밋 금지.
# ASSET_SECRET_KEY=
